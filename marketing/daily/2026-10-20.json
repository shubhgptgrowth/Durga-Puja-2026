 "items": [
  {
   "id": "p1",
   "type": "photo",
   "render": "editorial",
   "slides": [
    {
     "t": "cover",
     "kicker": "Navadurga · Day 9 of 9",
     "title": "Siddhidatri, the giver of fulfilment",
     "bn": "মা সিদ্ধিদাত্রী",
     "sub": "The ninth form of Durga, worshipped on Navami",
     "photo": {
      "src": "https://upload.wikimedia.org/wikipedia/commons/d/dc/State_Bank_Park_%28SB_Park%29_Thakurpukur_Sarbojanin_Durga_Puja_2025_06.jpg",
      "artist": "Goutam1962",
      "license": "CC BY-SA 4.0",
      "cx": 0.5,
      "cy": 0.4
     }
    },
    {
     "t": "step",
     "kicker": "Who she is",
     "title": "The ninth and last form",
     "bn": "সিদ্ধিদায়িনী",
     "body": "The giver of siddhis, spiritual attainments. She is worshipped by gods, sages and seekers, and her day closes Navratri with prayers for fulfilment."
    },
    {
     "t": "step",
     "kicker": "How she is shown",
     "title": "Seated on a lotus",
     "bn": "পদ্মাসনা",
     "body": "She sits on a lotus with four arms holding a discus, conch, mace and lotus. Many households hold a havan and kanya pujan on Navami."
    },
    {
     "t": "mantra",
     "kicker": "Siddhidatri dhyana mantra",
     "script": "deva",
     "text": "सिद्धगन्धर्वयक्षाद्यैरसुरैरमरैरपि ।\nसेव्यमाना सदा भूयात् सिद्धिदा सिद्धिदायिनी ॥",
     "translit": "Siddha gandharva yakshadyair asurair amarair api, sevyamana sada bhuyat siddhida siddhidayini",
     "meaning": "May Siddhidatri, served always by siddhas, gandharvas, yakshas, asuras and gods alike, grant us fulfilment."
    },
